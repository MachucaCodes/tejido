{
 "name": "Admin home archived split, admin 404, member menu",
 "base_url": "https://tejido-zeta.vercel.app",
 "environment": "production after merge",
 "viewport": {
  "width": 1440,
  "height": 900
 },
 "pace_ms": 600,
 "redact": [
  ".font-mono"
 ],
 "limitations": [
  "Member removal is opened to its confirm step but not run, so no real member is removed"
 ],
 "steps": [
  {
   "do": "goto",
   "url": "/admin"
  },
  {
   "do": "expect_text",
   "text": "All sessions"
  },
  {
   "do": "expect_text",
   "text": "Archived (1)",
   "label": "archived session is in its own group"
  },
  {
   "do": "expect_text",
   "text": "archived"
  },
  {
   "do": "screenshot",
   "label": "admin home, archived apart and dimmed"
  },
  {
   "do": "goto",
   "url": "/admin/sessions/zz-no-such-session"
  },
  {
   "do": "expect_text",
   "text": "Back to sessions"
  },
  {
   "do": "expect_text",
   "text": "Lists",
   "label": "admin nav is shown"
  },
  {
   "do": "screenshot",
   "label": "admin 404 inside admin layout"
  },
  {
   "do": "click",
   "text": "Back to sessions"
  },
  {
   "do": "expect_url",
   "match": "/admin$"
  },
  {
   "do": "goto",
   "url": "/admin/lists/1e22d2d0-e2aa-48f6-bf20-439f3539c5eb"
  },
  {
   "do": "expect_no_text",
   "text": "Remove",
   "label": "no top-level Remove on rows"
  },
  {
   "do": "screenshot",
   "label": "member rows with \u2026 menu"
  },
  {
   "do": "click",
   "selector": "[aria-label='Member actions']"
  },
  {
   "do": "expect_text",
   "text": "Remove from list"
  },
  {
   "do": "screenshot",
   "label": "menu open"
  },
  {
   "do": "click",
   "text": "Remove from list"
  },
  {
   "do": "expect_text",
   "text": "Click again to remove"
  },
  {
   "do": "screenshot",
   "label": "confirm step"
  },
  {
   "do": "press",
   "key": "Escape"
  },
  {
   "do": "expect_no_text",
   "text": "Click again to remove"
  }
 ],
 "login": "tejido"
}