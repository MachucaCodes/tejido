{
  "name": "Admin UI fixes at 1440",
  "base_url": "https://tejido-git-clock-abe489d2-ui-fix-lis-1c9b44-dane-myers-projects.vercel.app",
  "environment": "PR #8 preview, production Supabase, signed in as Dane (admin), read-only clicks",
  "viewport": { "width": 1440, "height": 900 },
  "pace_ms": 500,
  "limitations": ["Nothing saved: privacy confirm is cancelled, Rebuild and Create are not clicked", "Session load error state not reproducible on a working DB"],
  "steps": [
    { "do": "goto", "url": "/admin/lists" },
    { "do": "expect_text", "text": "New list" },
    { "do": "expect_no_text", "text": "Named groups of phone numbers" },
    { "do": "screenshot", "label": "lists index" },
    { "do": "click", "text": "New list" },
    { "do": "expect_visible", "selector": "#new-list-name" },
    { "do": "screenshot", "label": "new list dialog" },
    { "do": "press", "key": "Escape" },
    { "do": "goto", "url": "/admin/sessions/evolving-why-statement/logs" },
    { "do": "expect_text", "text": "matching calls" },
    { "do": "expect_no_text", "text": "stream_aborted" },
    { "do": "screenshot", "label": "logs populated" },
    { "do": "click", "text": "Filter" },
    { "do": "wait", "ms": 400 },
    { "do": "screenshot", "label": "logs filter menu open" },
    { "do": "click", "selector": "[role=menuitemradio]:has-text('Facilitator')" },
    { "do": "expect_url", "match": "kind=facilitator_turn" },
    { "do": "screenshot", "label": "logs with kind chip" },
    { "do": "click", "selector": "[aria-label='Remove filter Facilitator']" },
    { "do": "expect_js", "js": "location.search.includes('kind=')", "equals": false, "label": "chip removes the filter" },
    { "do": "goto", "url": "/admin/sessions/why-statement-v2/logs" },
    { "do": "expect_text", "text": "0 of 0 matching calls" },
    { "do": "expect_no_text", "text": "Filter" },
    { "do": "screenshot", "label": "logs empty session" },
    { "do": "goto", "url": "/admin/sessions/daily-life-together" },
    { "do": "expect_text", "text": "Privacy:" },
    { "do": "expect_no_text", "text": "connect_consent_at" },
    { "do": "screenshot", "label": "overview privacy row" },
    { "do": "click", "text": "Make anonymous" },
    { "do": "expect_text", "text": "Make this session anonymous?" },
    { "do": "screenshot", "label": "privacy confirm dialog" },
    { "do": "click", "text": "Cancel" },
    { "do": "expect_no_text", "text": "Make this session anonymous?" },
    { "do": "expect_text", "text": "Connect" },
    { "do": "goto", "url": "/admin/sessions/evolving-why-statement/synthesis" },
    { "do": "expect_text", "text": "Find sources" },
    { "do": "screenshot", "label": "synthesis" },
    { "do": "goto", "url": "/admin" },
    { "do": "expect_no_text", "text": "ES" , "label": "no language switch on admin"},
    { "do": "click", "text": "Or fill in the form yourself" },
    { "do": "expect_text", "text": "Summary focus" },
    { "do": "screenshot", "label": "admin home with manual form" },
    { "do": "goto", "url": "/admin/sessions" },
    { "do": "screenshot", "label": "sessions list" },
    { "do": "goto", "url": "/admin/does-not-exist" },
    { "do": "expect_text", "text": "Back to sessions" },
    { "do": "screenshot", "label": "admin 404" }
  ]
}
