{
  "name": "Session overview + settings header and rows at 390px",
  "base_url": "https://tejido-zeta.vercel.app",
  "environment": "production after merge, read-only",
  "viewport": { "width": 390, "height": 900 },
  "pace_ms": 600,
  "limitations": ["Looks only; Close session / Connect buttons not clicked"],
  "steps": [
    { "do": "goto", "url": "/admin/sessions/esm-rental-policy" },
    { "do": "expect_text", "text": "Copy join link" },
    { "do": "wait", "ms": 1500 },
    { "do": "screenshot", "label": "overview 390" },
    { "do": "expect_js", "js": "/· open ·/.test(document.querySelector('header p').textContent)", "equals": false, "label": "meta line has no 'open'" },
    { "do": "goto", "url": "/admin/sessions/esm-rental-policy/settings" },
    { "do": "expect_text", "text": "Make it a Connect session" },
    { "do": "wait", "ms": 1000 },
    { "do": "screenshot", "label": "settings 390" }
  ]
}
