{
  "name": "PR3: archive confirm, session layout, logs kinds/paging, dates, list delete, language, wording",
  "base_url": "http://localhost:4173",
  "environment": "local next start of this branch, prod Supabase, read-only",
  "login": "tejido",
  "viewport": { "width": 1440, "height": 900 },
  "pace_ms": 500,
  "redact": [".font-mono"],
  "limitations": ["Archive and Delete list dialogs are opened and cancelled, never confirmed"],
  "steps": [
    { "do": "goto", "url": "/admin" },
    { "do": "expect_text", "text": "Home" },
    { "do": "expect_no_text", "text": "Your questions" },
    { "do": "click", "text": "Or fill in the form yourself" },
    { "do": "expect_text", "text": "Link name" },
    { "do": "expect_text", "text": "The question people are asked." },
    { "do": "screenshot", "label": "home: Home nav, manual form labels" },
    { "do": "goto", "url": "/admin/sessions/evolving-why-statement" },
    { "do": "expect_visible", "selector": "h1" },
    { "do": "expect_text", "text": "CST" },
    { "do": "expect_text", "text": "points" },
    { "do": "expect_no_text", "text": "Archive session" },
    { "do": "screenshot", "label": "session page: topic h1, results first, archive icon in header" },
    { "do": "click", "selector": "[aria-label='Archive session']" },
    { "do": "expect_text", "text": "Nothing is deleted" },
    { "do": "screenshot", "label": "archive confirm" },
    { "do": "click", "text": "Cancel" },
    { "do": "expect_no_text", "text": "Nothing is deleted" },
    { "do": "goto", "url": "/admin/sessions/evolving-why-statement/logs" },
    { "do": "expect_text", "text": "analyze" },
    { "do": "expect_text", "text": "summary" },
    { "do": "expect_no_text", "text": "cluster" },
    { "do": "expect_text", "text": "Showing 200 of 522 matching calls" },
    { "do": "screenshot", "label": "logs: real kinds and totals" },
    { "do": "press", "key": "End" },
    { "do": "wait", "ms": 500 },
    { "do": "screenshot", "label": "logs: Older link" },
    { "do": "click", "text": "Older →" },
    { "do": "expect_text", "text": "older page" },
    { "do": "expect_text", "text": "← Newest" },
    { "do": "screenshot", "label": "logs: older page" },
    { "do": "click", "selector": "a[href$='/logs?kind=summarize_session']" },
    { "do": "expect_url", "match": "kind=summarize_session" },
    { "do": "screenshot", "label": "logs: summary filter" },
    { "do": "goto", "url": "/admin/sessions/evolving-why-statement/synthesis" },
    { "do": "expect_text", "text": "CST" },
    { "do": "screenshot", "label": "synthesis times with zone" },
    { "do": "goto", "url": "/admin/lists/1e22d2d0-e2aa-48f6-bf20-439f3539c5eb" },
    { "do": "expect_text", "text": "(auto)" },
    { "do": "expect_no_text", "text": "Click again to delete" },
    { "do": "press", "key": "End" },
    { "do": "wait", "ms": 500 },
    { "do": "screenshot", "label": "list: language with auto, trash icon" },
    { "do": "click", "selector": "[aria-label='Delete list']" },
    { "do": "expect_text", "text": "Its numbers are kept" },
    { "do": "screenshot", "label": "delete list confirm" },
    { "do": "click", "text": "Cancel" },
    { "do": "goto", "url": "/admin/lists/not-a-uuid" },
    { "do": "expect_text", "text": "List not found" },
    { "do": "expect_text", "text": "Lists" },
    { "do": "screenshot", "label": "malformed list id" },
    { "do": "goto", "url": "/admin/lists/00000000-0000-0000-0000-000000000000" },
    { "do": "expect_text", "text": "List not found" },
    { "do": "screenshot", "label": "unknown list id" }
  ]
}
