{
  "name": "Session overview + settings header and rows at 1280px",
  "base_url": "https://tejido-git-clock-fe97bacd-ui-fix-on-4ffbee-dane-myers-projects.vercel.app",
  "environment": "PR #16 preview, production data, read-only (no buttons that save clicked)",
  "viewport": { "width": 1280, "height": 900 },
