{
  "name": "Lists pages render normally on production after the error-state change",
  "base_url": "https://tejido-zeta.vercel.app",
  "environment": "production after merge, read-only",
  "login": "tejido",
  "viewport": { "width": 1440, "height": 900 },
  "pace_ms": 600,
  "redact": [".font-mono"],
  "steps": [
    { "do": "goto", "url": "/admin/lists" },
    { "do": "expect_text", "text": "Test" },
    { "do": "expect_no_text", "text": "Couldn't load" },
    { "do": "expect_no_text", "text": "No lists yet." },
    { "do": "screenshot", "label": "lists page normal" },
    { "do": "goto", "url": "/admin/lists/1e22d2d0-e2aa-48f6-bf20-439f3539c5eb" },
    { "do": "expect_text", "text": "2 numbers" },
    { "do": "expect_no_text", "text": "Couldn't load" },
    { "do": "expect_visible", "selector": "[aria-label='Member actions']" },
    { "do": "screenshot", "label": "list detail normal" }
  ]
}
