    { "do": "wait", "ms": 400 },
    { "do": "screenshot", "label": "bottom" },
    { "do": "expect_js", "js": "(window.scrollTo(0,0), document.querySelector('details.group summary').click(), true)", "equals": true, "label": "open first theme" },
    { "do": "wait", "ms": 400 },
    { "do": "screenshot", "label": "first theme open" },
    { "do": "expect_js", "js": "(()=>{const a=[...document.querySelectorAll('a')].find(x=>x.textContent.startsWith('See the'));return a?a.getAttribute('href'):null})()", "equals": "/s/evolving-why-statement/points?theme=?", "label": "points link href" }
