{
  "name": "Lists audit (look only)",
  "base_url": "https://tejido-zeta.vercel.app",
  "login": "tejido",
  "environment": "production, read-only",
  "viewport": {"width": 1440, "height": 900},
  "pace_ms": 600,
  "redact": ["li .font-mono", "li p.truncate.font-medium"],
  "limitations": ["Look only: no saves, no removes"],
  "steps": [
    {"do": "goto", "url": "/admin"},
    {"do": "wait", "ms": 1500},
    {"do": "screenshot", "label": "sessions-index"},
    {"do": "goto", "url": "/admin/lists"},
    {"do": "expect_text", "text": "New list"},
    {"do": "screenshot", "label": "lists-index"},
    {"do": "click", "text": "New list"},
    {"do": "wait", "ms": 800},
    {"do": "screenshot", "label": "new-list-dialog"},
    {"do": "press", "key": "Escape"},
    {"do": "goto", "url": "/admin/lists/1e22d2d0-e2aa-48f6-bf20-439f3539c5eb"},
    {"do": "expect_text", "text": "Members"},
    {"do": "expect_js", "js": "(()=>{document.querySelectorAll('ul.divide-y li').forEach((li,i)=>{const n=li.querySelector('p.truncate');if(n)n.textContent='Member '+(i+1);const p=li.querySelector('.font-mono');if(p)p.textContent='+506 0000 000'+i;});return 'ok'})()", "equals": "ok"},
    {"do": "screenshot", "label": "list-detail"},
    {"do": "click", "text": "Edit"},
    {"do": "wait", "ms": 800},
    {"do": "screenshot", "label": "edit-dialog"},
    {"do": "press", "key": "Escape"},
    {"do": "wait", "ms": 500},
    {"do": "click", "text": "Add numbers"},
    {"do": "wait", "ms": 800},
    {"do": "screenshot", "label": "add-numbers-dialog"},
    {"do": "press", "key": "Escape"},
    {"do": "wait", "ms": 500},
    {"do": "click", "selector": "[aria-label='Member actions']"},
    {"do": "wait", "ms": 600},
    {"do": "screenshot", "label": "member-menu"},
    {"do": "press", "key": "Escape"},
    {"do": "goto", "url": "/admin/lists/00000000-0000-0000-0000-000000000000"},
    {"do": "wait", "ms": 1500},
    {"do": "screenshot", "label": "list-404"},
    {"do": "goto", "url": "/admin/lists/not-a-uuid"},
    {"do": "wait", "ms": 1500},
    {"do": "screenshot", "label": "list-bad-id"}
  ]
}
