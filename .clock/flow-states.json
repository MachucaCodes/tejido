{
 "name": "Session overview: other states (connect, no themes, 0-point theme, archived)",
 "base_url": "https://tejido-git-clock-2d4e9318-ui-mockup-2d6068-dane-myers-projects.vercel.app",
 "environment": "PR #7 preview, production database, read-only (no clicks that write)",
 "viewport": {
  "width": 1440,
  "height": 900
 },
 "pace_ms": 600,
 "redact": [
  "ul.max-h-72",
  "input",
  "textarea"
 ],
 "limitations": [
  "Looks only: nothing sent, saved or toggled"
 ],
 "steps": [
  {
   "do": "goto",
   "url": "/admin/sessions/daily-life-together"
  },
  {
   "do": "expect_text",
   "text": "No themes yet.",
   "timeout_ms": 30000,
   "label": "no themes: empty line"
  },
  {
   "do": "expect_text",
   "text": "Connect session"
  },
  {
   "do": "expect_text",
   "text": "Make anonymous"
  },
  {
   "do": "expect_js",
   "js": "(() => { document.querySelector('button[aria-label^=\"Participants are told\"]').focus(); return true; })()",
   "equals": true,
   "label": "focus connect info icon"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "expect_visible",
   "selector": "[role=tooltip], [data-slot=tooltip-content]",
   "label": "connect explanation in tooltip"
  },
  {
   "do": "screenshot",
   "label": "connect session, no themes"
  },
  {
   "do": "goto",
   "url": "/admin/sessions/esm-rental-policy"
  },
  {
   "do": "expect_text",
   "text": "Themes \u00b7 8",
   "timeout_ms": 30000
  },
  {
   "do": "expect_text",
   "text": "0 points",
   "label": "zero-point themes show 0 points"
  },
  {
   "do": "expect_js",
   "js": "(() => { const d=[...document.querySelectorAll('details.group')].find(x=>x.querySelector('summary').textContent.includes('0 points')); d.open=true; return !d.querySelector('a'); })()",
   "equals": true,
   "label": "0-point theme opens with no points link"
  },
  {
   "do": "wait",
   "ms": 400
  },
  {
   "do": "screenshot",
   "label": "0-point theme open"
  },
  {
   "do": "goto",
   "url": "/admin/sessions/why-statement-v2"
  },
  {
   "do": "expect_text",
   "text": "Open the session to send invites.",
   "timeout_ms": 30000,
   "label": "archived: invites disabled with its note"
  },
  {
   "do": "screenshot",
   "label": "archived session"
  }
 ]
}